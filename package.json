{
  "name": "local-meeting-room-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地会议室查询与预订系统（RFC-0001）",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.8.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
