# Agent parser environment variables.
# RFC-0002: Meeting Room Agent Orchestrator

NEX_API_BASE_URL=https://northgate.xiaobei.top/v1
NEX_API_KEY=replace_with_server_side_api_key
NEX_MODEL=nex-agi/Nex-N2-Pro

# Backend business API base URL consumed by the Agent orchestrator.
MEETING_ROOM_API_BASE_URL=http://localhost:3000
MEETING_ROOM_TIME_ZONE=Asia/Shanghai

# Local demo identity. Use "admin" only when validating room/rule mutations.
MEETING_ROOM_DEMO_USER_ID=local-user
MEETING_ROOM_DEMO_ROLE=member

# Optional persistence overrides.
# DATA_DIR=./data
# DATABASE_URL=file:./data/meeting-room.sqlite3
